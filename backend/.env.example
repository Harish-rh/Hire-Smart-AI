# HireSmart AI - Backend Environment Configuration

# Django Settings
SECRET_KEY=django-insecure-hiresmart-ai-local-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (PostgreSQL)
# Note: For Phase 1 check, SQLite can be used if PostgreSQL is not yet configured.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hiresmart_db
DB_USER=hiresmart_user
DB_PASSWORD=hiresmart_password
DB_HOST=127.0.0.1
DB_PORT=5432
USE_SQLITE=True

# Local AI (Ollama) Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
AI_TIMEOUT_SECONDS=30
MAX_RESUME_TEXT_CHARS=4000
